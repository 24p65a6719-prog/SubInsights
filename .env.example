# SubInsights Backend Configuration
# Copy this file to .env and fill in the values to enable real email sending

# Email Configuration (for production use)
# ==========================================

# Set to 'false' to disable demo mode and enable real SMTP email sending
DEMO_MODE=true

# Gmail SMTP Configuration
# To use Gmail:
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the 16-character password generated below

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Sender email address (use your Gmail address)
SENDER_EMAIL=your-email@gmail.com

# Gmail App Password (16 characters, from step 2 above)
# DO NOT use your regular Gmail password
SENDER_PASSWORD=your_gmail_app_password_here

# Alternative: Use other SMTP providers
# Example for Mailgun:
# SMTP_SERVER=smtp.mailgun.org
# SMTP_PORT=587
# SENDER_EMAIL=postmaster@your-domain.mailgun.org
# SENDER_PASSWORD=your-mailgun-api-key

# Application Configuration
# =========================

ENVIRONMENT=development
DEBUG=true

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database Configuration
# For production, modify these settings
DB_TYPE=in_memory
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subinsights
DB_USER=postgres
DB_PASSWORD=password

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=100/minute

# Security
CORS_ORIGINS=*

# Feature Flags
ENABLE_GEOFENCING=true
ENABLE_ALERTS=true
ENABLE_NOTIFICATIONS=true
